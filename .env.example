# Canonical site URL (used for metadata, Open Graph, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://www.anthonyjquispilaya.com

# Leave empty for root deploys (Vercel / custom domain). The GitHub Pages
# workflow sets this to "/<repo-name>" automatically.
NEXT_PUBLIC_BASE_PATH=

# Contact form endpoint. Any service that accepts a JSON POST and is public by
# design, e.g. Formspree: https://formspree.io/f/<your-form-id>
# Leave empty and the form opens the visitor's email app instead (mailto).
# Never put a private API key here — NEXT_PUBLIC_ values ship to the browser.
NEXT_PUBLIC_CONTACT_ENDPOINT=
